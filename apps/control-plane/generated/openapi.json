{
  "openapi": "3.1.1",
  "info": {
    "title": "Golem control plane",
    "version": "v1"
  },
  "paths": {
    "/api/v1/runtime/events": {
      "post": {
        "operationId": "controlPlaneRuntimeIngest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "schema_version": {
                    "type": "string",
                    "const": "golem.runtime-signal/v1"
                  },
                  "event_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "event_kind": {
                    "type": "string",
                    "enum": [
                      "project.observed",
                      "session.started",
                      "session.resumed",
                      "session.activity",
                      "session.idle",
                      "session.waiting",
                      "session.metadata_patched",
                      "session.ended",
                      "endpoint.claimed",
                      "endpoint.heartbeat",
                      "endpoint.readiness_changed",
                      "endpoint.released",
                      "capabilities.reported"
                    ]
                  },
                  "producer": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "producer_instance_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "harness": {
                    "type": "string",
                    "enum": [
                      "claude",
                      "codex",
                      "opencode",
                      "pi"
                    ]
                  },
                  "producer_sequence": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "correlation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "causation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "deduplication_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "owner_fence": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "clocks": {
                    "type": "object",
                    "properties": {
                      "source_observed_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "source_event_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "received_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      },
                      "materialized_at": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      }
                    },
                    "required": [
                      "source_observed_at",
                      "received_at"
                    ],
                    "additionalProperties": false
                  },
                  "provenance": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "enum": [
                          "adapter",
                          "api",
                          "launcher",
                          "legacy_import",
                          "migration"
                        ]
                      },
                      "evidence_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "confidence": {
                        "type": "string",
                        "enum": [
                          "verified",
                          "observed",
                          "inferred",
                          "legacy"
                        ]
                      }
                    },
                    "required": [
                      "source",
                      "confidence"
                    ],
                    "additionalProperties": false
                  },
                  "clear_fields": {
                    "maxItems": 64,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "payload": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "schema_version",
                  "event_id",
                  "event_kind",
                  "producer",
                  "producer_instance_id",
                  "harness",
                  "correlation_id",
                  "deduplication_key",
                  "clocks",
                  "provenance",
                  "clear_fields",
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "durably spooled",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "type": "string",
                      "const": "golem.runtime-ingest-receipt/v1"
                    },
                    "event_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "spooled",
                        "already_pending"
                      ]
                    }
                  },
                  "required": [
                    "schema_version",
                    "event_id",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "invalid runtime signal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_version",
                    "code",
                    "message",
                    "correlation_id"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "string",
                      "const": "golem.api-error/v1"
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "correlation_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "details": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_version",
                    "code",
                    "message",
                    "correlation_id"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "string",
                      "const": "golem.api-error/v1"
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "correlation_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "details": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "runtime ingress unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "schema_version",
                    "code",
                    "message",
                    "correlation_id"
                  ],
                  "properties": {
                    "schema_version": {
                      "type": "string",
                      "const": "golem.api-error/v1"
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "correlation_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "details": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "controlPlaneLive",
        "responses": {
          "200": {
            "description": "live",
