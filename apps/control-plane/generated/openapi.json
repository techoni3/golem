                        "live",
                        "ready"
                      ]
                    },
                    "instance_id": {
                      "type": "string",
                      "pattern": "^cpi_[0-9a-f-]{36}$"
                    },
                    "runtime": {
                      "type": "object",
                      "properties": {
                        "inbox": {
                          "type": "object",
                          "properties": {
                            "pending": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "processing": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "archived": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "quarantined": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "retrying": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "oldestPendingAgeMs": {
                              "type": "number",
                              "minimum": 0
                            },
                            "oldestRetryAgeMs": {
                              "type": "number",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "pending",
                            "processing",
                            "archived",
                            "quarantined",
                            "retrying"
                          ],
                          "additionalProperties": false
                        },
                        "outbox": {
                          "type": "object",
                          "properties": {
                            "pending": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "claimed": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "published": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "permanentFailures": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "oldestRetryAgeMs": {
                              "type": "number",
                              "minimum": 0
                            },
                            "lastSuccessAt": {
                              "type": "string",
                              "format": "date-time",
                              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                            }
                          },
                          "required": [
                            "pending",
                            "claimed",
                            "published",
                            "permanentFailures"
                          ],
                          "additionalProperties": false
                        },
                        "lastSuccessfulMaterializationAt": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                        },
                        "lastTickError": {
                          "type": "string",
                          "const": "runtime tick deferred"
                        }
                      },
                      "required": [
                        "inbox",
                        "outbox"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "schema_version",
                    "status",
                    "instance_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
