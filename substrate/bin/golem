#!/usr/bin/env bash
# golem — unified CLI for the substrate.
#
# Subcommands:
#   install      One-time global setup. Idempotent.
#   reinstall    Cleanup, then install. Useful after moving the substrate dir.
#   cleanup      Reverse `install`. Only removes what install created.
#   session      CEO sessions: start, list, stop, claim, release.
#                  `golem session` (no sub) == `golem session start`.
#   project      Project registry: register, unregister, list, info.
#   dashboard    Start the admin dashboard.
#   doctor       Sanity-check the environment.
#   status       Combined snapshot: sessions + projects + dashboard URL.
#   help         Show this help.

set -euo pipefail

# ---- Locate the substrate (resolve symlinks so this works via ~/.local/bin) -

SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT" ]]; do
  link_target="$(readlink "$SCRIPT")"
  if [[ "$link_target" = /* ]]; then
    SCRIPT="$link_target"
  else
    SCRIPT="$(cd "$(dirname "$SCRIPT")" && cd "$(dirname "$link_target")" && pwd)/$(basename "$link_target")"
  fi
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
SUBSTRATE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# ---- Config ---------------------------------------------------------------

GOLEM_ROOT="${GOLEM_ROOT:-$HOME/Documents/software/experiments/golem}"

TARGET_AGENTS="$HOME/.claude/agents"
TARGET_SKILLS="$HOME/.claude/skills"
TARGET_COMMANDS="$HOME/.claude/commands"
TARGET_PERSONAS="$HOME/.claude/personas"
TARGET_BIN="$HOME/.local/bin"
PREFIX="golem-"

DASHBOARD_DIR="$(cd "$SUBSTRATE_DIR/../dashboard" 2>/dev/null && pwd || echo "")"
CHANNEL_DIR="$SUBSTRATE_DIR/channels/golem"
MCP_JSON_PATH="$GOLEM_ROOT/.mcp.json"
GOLEM_BIN_LINK="$TARGET_BIN/golem"

# v3 registry paths
GOLEM_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/golem"
PROJECTS_FILE="$GOLEM_CONFIG_DIR/projects.json"
SESSIONS_FILE="$GOLEM_CONFIG_DIR/sessions.json"

# ---- Output helpers -------------------------------------------------------

ok()    { printf '  \033[32m✓\033[0m %s\n' "$*"; }
skip()  { printf '  \033[2m·\033[0m %s\n' "$*"; }
warn()  { printf '  \033[33m!\033[0m %s\n' "$*" >&2; }
fail()  { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; }
head1() { printf '\n\033[1m%s\033[0m\n' "$*"; }

# Emit a single-line JSON error to stderr (used by the v3 subcommands).
err_json() {
  # err_json <code> <error_key> [<field>=<value> …]
  local code="$1" key="$2"
  shift 2
  local fields=""
  for f in "$@"; do
    local k="${f%%=*}"
    local v="${f#*=}"
    if [[ "$v" =~ ^[0-9]+$ ]] || [[ "$v" == "null" ]] || [[ "$v" == "true" ]] || [[ "$v" == "false" ]]; then
      fields+="\"$k\":$v,"
    else
      fields+="\"$k\":\"$v\","
    fi
  done
  fields="${fields%,}"
  if [[ -n "$fields" ]]; then
    printf '{"error":"%s",%s}\n' "$key" "$fields" >&2
  else
    printf '{"error":"%s"}\n' "$key" >&2
  fi
  exit "$code"
}

# ---- Symlink helpers ------------------------------------------------------

link_target() { [[ -L "$1" ]] && readlink "$1" || true; }

# Is $1 a symlink that points into our substrate?
is_ours() {
  local link="$1"
  local target
  target="$(link_target "$link")"
  [[ -n "$target" ]] && [[ "$target" == "$SUBSTRATE_DIR"/* ]]
}

link_one() {
  # link_one <src> <dst> <kind>
  local src="$1" dst="$2" kind="$3"
  if [[ -L "$dst" ]] && is_ours "$dst"; then
    skip "$kind already linked: $(basename "$dst")"
  elif [[ -e "$dst" ]]; then
    warn "$kind exists, not overwriting: $dst"
  else
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    ok "$kind linked: $(basename "$dst")"
  fi
}

# Unlink every entry in $1 that points into our substrate.
unlink_dir_contents() {
  local dir="$1" kind="$2"
  [[ -d "$dir" ]] || return 0
  shopt -s nullglob
  for entry in "$dir"/*; do
    [[ -L "$entry" ]] || continue
    if is_ours "$entry"; then
      rm "$entry"
      ok "removed $kind: $(basename "$entry")"
    fi
  done
  shopt -u nullglob
}

# ---- .mcp.json handling ---------------------------------------------------

# What we want $GOLEM_ROOT/.mcp.json to contain (when it only has our entry).
expected_mcp_json() {
  cat <<EOF
{
  "mcpServers": {
    "golem": {
      "command": "node",
      "args": ["$SUBSTRATE_DIR/channels/golem/index.js"]
    }
  }
}
EOF
}

install_mcp_json() {
  if [[ ! -d "$GOLEM_ROOT" ]]; then
    mkdir -p "$GOLEM_ROOT"
  fi
  if [[ ! -f "$MCP_JSON_PATH" ]]; then
    expected_mcp_json > "$MCP_JSON_PATH"
    ok "wrote $MCP_JSON_PATH"
    return
  fi
  # File exists. Compare against what we'd write.
  if diff -q <(expected_mcp_json) "$MCP_JSON_PATH" >/dev/null 2>&1; then
    skip ".mcp.json already correct: $MCP_JSON_PATH"
    return
  fi
  # Exists but differs. Don't overwrite — guide the user.
  warn ".mcp.json already exists and differs: $MCP_JSON_PATH"
  warn "merge this entry by hand:"
  expected_mcp_json | sed 's/^/      /' >&2
}

cleanup_mcp_json() {
  [[ -f "$MCP_JSON_PATH" ]] || { skip ".mcp.json absent: $MCP_JSON_PATH"; return; }
  if diff -q <(expected_mcp_json) "$MCP_JSON_PATH" >/dev/null 2>&1; then
    rm "$MCP_JSON_PATH"
    ok "removed $MCP_JSON_PATH"
  else
    warn ".mcp.json has been hand-edited; leaving alone: $MCP_JSON_PATH"
    warn "remove the 'golem' entry manually if you want it gone"
  fi
}

# ---- npm helpers ----------------------------------------------------------

npm_install_in() {
  local dir="$1" label="$2"
  [[ -d "$dir" ]] || { warn "$label dir missing: $dir"; return; }
  [[ -f "$dir/package.json" ]] || { warn "$label has no package.json: $dir"; return; }
  if [[ -d "$dir/node_modules" ]]; then
    skip "$label deps already installed"
    return
  fi
  command -v npm >/dev/null 2>&1 || { fail "$label needs npm; install Node 20+ and retry"; return; }
  ( cd "$dir" && npm install --silent ) && ok "$label deps installed" || fail "$label npm install failed"
}

# ---- v3: Registry I/O (flock + atomic write) ------------------------------

# Make sure the config dir + both registry files exist with empty schemas.
ensure_registry() {
  mkdir -p "$GOLEM_CONFIG_DIR"
  [[ -f "$PROJECTS_FILE" ]] || printf '%s\n' '{"version":1,"projects":[]}' > "$PROJECTS_FILE"
  [[ -f "$SESSIONS_FILE" ]] || printf '%s\n' '{"version":1,"sessions":[]}' > "$SESSIONS_FILE"
}

# Acquire an exclusive mutex via mkdir (atomic on POSIX, portable to macOS
# where flock(1) is not a stock util). Retries with backoff; gives up after ~5s.
registry_lock() {
  local lockdir="$1.lockdir"
  local tries=50
  while ! mkdir "$lockdir" 2>/dev/null; do
    if (( --tries == 0 )); then
      return 1
    fi
    sleep 0.1
  done
  return 0
}

registry_unlock() {
  rmdir "$1.lockdir" 2>/dev/null || true
}

# Take an exclusive lock on a registry file, run a jq program against current
# contents, atomically write the result back.
registry_update() {
  # registry_update <path> <jq_program>
  local path="$1" prog="$2"
  ensure_registry
  local tmp="$path.tmp.$$"
  if ! registry_lock "$path"; then
    err_json 20 registry_lock_timeout "path=$path"
  fi
  if jq "$prog" "$path" > "$tmp"; then
    mv -f "$tmp" "$path"
    registry_unlock "$path"
    return 0
  else
    rm -f "$tmp"
    registry_unlock "$path"
    err_json 20 registry_write_failed "path=$path"
  fi
}

# Read the registry file as JSON (stdout).
registry_read() {
  ensure_registry
  cat "$1"
}

# Idempotently ensure the golem-root project entry exists in projects.json.
ensure_golem_root_registered() {
  ensure_registry
  local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  registry_update "$PROJECTS_FILE" \
    "if (.projects | map(.id) | index(\"golem-root\")) == null
     then .projects += [{
       id: \"golem-root\",
       name: \"Golem Root\",
       path: \"$GOLEM_ROOT\",
       kind: \"root\",
       registered_at: \"$now\"
     }] else . end"
}

# Slug a string: lowercase, hyphens, alnum-and-hyphen only, ≤ 48 chars.
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g' \
    | cut -c 1-48
}

# Resolve an absolute path. Uses python3 if available (handles non-existent
# paths), falls back to realpath.
resolve_path() {
  local p="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "import os,sys; print(os.path.abspath(os.path.expanduser(sys.argv[1])))" "$p"
  else
    # realpath errors on missing path; expand ~ manually first.
    [[ "$p" == "~"* ]] && p="$HOME${p:1}"
    if [[ -e "$p" ]]; then realpath "$p"; else printf '%s\n' "$p"; fi
  fi
}

# Lookup a project entry by id, path, or partial path. Echoes the JSON object
# or empty string if not found.
project_lookup() {
  # project_lookup <id-or-path>
  local key="$1"
  ensure_registry
  local resolved; resolved="$(resolve_path "$key")"
  jq -c --arg key "$key" --arg path "$resolved" '
    .projects[] | select(.id == $key or .path == $path or .path == $key)
  ' "$PROJECTS_FILE" | head -1
}

# Check that a process is alive. Returns 0 (alive) or 1 (dead).
pid_alive() {
  local pid="$1"
  [[ -n "$pid" && "$pid" != "0" && "$pid" != "null" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

# Garbage-collect stale sessions (whose pid is no longer alive OR which have an
# empty session_id — those are corrupt residue). Returns the number of rows
# removed. Uses a non-whitespace delimiter so empty-leading fields don't fold.
gc_stale_sessions() {
  ensure_registry
  local stale=()
  local row_sid row_pid
  while IFS='|' read -r row_sid row_pid; do
    if [[ -z "$row_sid" ]]; then
      # Corrupt row — drop it (use a sentinel so the filter removes it by exact match).
      stale+=("__EMPTY_SID__")
      continue
    fi
    if ! pid_alive "$row_pid"; then
      stale+=("$row_sid")
    fi
  done < <(jq -r '.sessions[] | "\(.session_id)|\(.pid)"' "$SESSIONS_FILE")
  if [[ ${#stale[@]} -eq 0 ]]; then
    return 0
  fi
  # Build a filter that removes either by session_id match OR removes empty-sid rows.
  local removes_empty=0 has_real=0
  local filter='.sessions |= map(select('
  local sep=''
  for sid in "${stale[@]}"; do
    if [[ "$sid" == "__EMPTY_SID__" ]]; then
      filter+="$sep (.session_id // \"\" | length) > 0"
      removes_empty=1
    else
      filter+="$sep .session_id != \"$sid\""
      has_real=1
    fi
    sep=' and'
  done
  filter+='))'
  registry_update "$SESSIONS_FILE" "$filter"
  return 0
}

# ---- v3: Project subcommands ----------------------------------------------

project_register() {
  local path="" name="" id="" kind=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)  name="$2"; shift 2 ;;
      --id)    id="$2";   shift 2 ;;
      --kind)  kind="$2"; shift 2 ;;
      --*)     fail "unknown flag: $1"; exit 2 ;;
      *)       [[ -z "$path" ]] && path="$1" || { fail "extra arg: $1"; exit 2; }; shift ;;
    esac
  done
  [[ -n "$path" ]] || { fail "usage: golem project register <path> [--name <n>] [--id <slug>] [--kind project|external]"; exit 2; }

  local abs; abs="$(resolve_path "$path")"
  [[ -d "$abs" ]] || { fail "path does not exist: $abs"; exit 2; }

  ensure_golem_root_registered

  # Default kind: project if under $GOLEM_ROOT/golem-projects/, else external.
  if [[ -z "$kind" ]]; then
    if [[ "$abs" == "$GOLEM_ROOT/golem-projects/"* ]]; then
      kind="project"
    else
      kind="external"
    fi
  fi
  case "$kind" in
    project|external|root) ;;
    *) fail "invalid --kind: $kind"; exit 2 ;;
  esac

  # Default name from basename, slugified id.
  [[ -z "$name" ]] && name="$(basename "$abs")"
  [[ -z "$id" ]]   && id="$(slugify "$name")"

  # Collision checks.
  local existing_by_id existing_by_path
  existing_by_id="$(jq --arg id "$id" '[.projects[] | select(.id == $id)] | length' "$PROJECTS_FILE")"
  existing_by_path="$(jq --arg p "$abs" '[.projects[] | select(.path == $p)] | length' "$PROJECTS_FILE")"
  if [[ "$existing_by_id" != "0" ]]; then
    err_json 40 already_registered "id=$id" "by=id"
  fi
  if [[ "$existing_by_path" != "0" ]]; then
    err_json 40 already_registered "path=$abs" "by=path"
  fi

  local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local name_json; name_json="$(printf '%s' "$name" | jq -Rs .)"
  registry_update "$PROJECTS_FILE" \
    ".projects += [{
       id: \"$id\",
       name: $name_json,
       path: \"$abs\",
       kind: \"$kind\",
       registered_at: \"$now\"
     }]"
  ok "registered $id ($kind) → $abs"
}

project_unregister() {
  local key="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      --*)     fail "unknown flag: $1"; exit 2 ;;
      *)       [[ -z "$key" ]] && key="$1" || { fail "extra arg: $1"; exit 2; }; shift ;;
    esac
  done
  [[ -n "$key" ]] || { fail "usage: golem project unregister <id|path> [--force]"; exit 2; }

  ensure_registry
  local row; row="$(project_lookup "$key")"
  [[ -n "$row" ]] || { err_json 30 not_registered "key=$key"; }
  local id; id="$(jq -r '.id' <<<"$row")"

  # Refuse if any live session has it claimed.
  gc_stale_sessions
  local held; held="$(jq -c --arg id "$id" '.sessions[] | select(.claimed_project == $id)' "$SESSIONS_FILE" | head -1)"
  if [[ -n "$held" && "$force" -eq 0 ]]; then
    local s_id s_pid s_since
    s_id="$(jq -r '.session_id' <<<"$held")"
    s_pid="$(jq -r '.pid' <<<"$held")"
    s_since="$(jq -r '.claimed_at' <<<"$held")"
    err_json 40 still_claimed "project=$id" "held_by=$s_id" "pid=$s_pid" "since=$s_since"
  fi

  registry_update "$PROJECTS_FILE" \
    ".projects |= map(select(.id != \"$id\"))"
  ok "unregistered $id"
}

project_list() {
  local kind_filter="" json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --kind) kind_filter="$2"; shift 2 ;;
      --json) json=1; shift ;;
      *)      fail "unknown arg: $1"; exit 2 ;;
    esac
  done
  ensure_golem_root_registered
  if [[ $json -eq 1 ]]; then
    if [[ -n "$kind_filter" ]]; then
      jq --arg k "$kind_filter" '{version, projects: [.projects[] | select(.kind == $k)]}' "$PROJECTS_FILE"
    else
      cat "$PROJECTS_FILE"
    fi
    return 0
  fi

  head1 "Registered projects"
  if [[ -n "$kind_filter" ]]; then
    jq -r --arg k "$kind_filter" '.projects[] | select(.kind == $k) | "\(.id)\t\(.kind)\t\(.path)"' "$PROJECTS_FILE" | column -t -s $'\t' || true
  else
    jq -r '.projects[] | "\(.id)\t\(.kind)\t\(.path)"' "$PROJECTS_FILE" | column -t -s $'\t' || true
  fi
}

project_info() {
  local key="${1:-}"
  [[ -n "$key" ]] || { fail "usage: golem project info <id>"; exit 2; }
  ensure_registry
  local row; row="$(project_lookup "$key")"
  [[ -n "$row" ]] || { err_json 30 not_registered "key=$key"; }
  echo "$row" | jq .
  # Show current claim if any.
  gc_stale_sessions
  local id; id="$(jq -r '.id' <<<"$row")"
  local claim; claim="$(jq -c --arg id "$id" '.sessions[] | select(.claimed_project == $id)' "$SESSIONS_FILE" | head -1)"
  if [[ -n "$claim" ]]; then
    head1 "Currently claimed by"
    echo "$claim" | jq .
  fi
}

cmd_project() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    register)   project_register   "$@" ;;
    unregister) project_unregister "$@" ;;
    list|"")    project_list       "$@" ;;
    info)       project_info       "$@" ;;
    *)          fail "unknown project subcommand: $sub"; exit 2 ;;
  esac
}

# ---- v3: Session subcommands ----------------------------------------------

# UUID-v4 generator (uuidgen → fallback to /proc/sys/kernel/random/uuid).
gen_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then
    uuidgen | tr 'A-Z' 'a-z'
  elif [[ -r /proc/sys/kernel/random/uuid ]]; then
    cat /proc/sys/kernel/random/uuid
  else
    python3 -c 'import uuid; print(uuid.uuid4())'
  fi
}

# Build the channel args (legacy v2 behaviour, parameterised).
build_channel_args() {
  local channels="${GOLEM_CEO_CHANNELS:-server:golem}"
  local stock=() dev=()
  # shellcheck disable=SC2206
  local list=($channels)
  for spec in "${list[@]}"; do
    case "$spec" in
      server:*) dev+=("$spec") ;;
      *)        stock+=("$spec") ;;
    esac
  done
  CHANNEL_ARGS=()
  [[ ${#stock[@]} -gt 0 ]] && CHANNEL_ARGS+=(--channels "${stock[@]}")
  [[ ${#dev[@]}   -gt 0 ]] && CHANNEL_ARGS+=(--dangerously-load-development-channels "${dev[@]}")
}

# Append a session row. Optional claimed_project / claimed_at.
session_register_row() {
  local session_id="$1" pid="$2" claimed_project="$3"
  local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local cp_json="null" ca_json="null"
  if [[ -n "$claimed_project" && "$claimed_project" != "null" ]]; then
    cp_json="\"$claimed_project\""
    ca_json="\"$now\""
  fi
  registry_update "$SESSIONS_FILE" \
    ".sessions += [{
       session_id: \"$session_id\",
       pid: $pid,
       boot_time: \"$now\",
       claimed_project: $cp_json,
       claimed_at: $ca_json,
       last_seen_at: null,
       dashboard_url: null
     }]"
}

# Attempt to acquire a lock. Returns 0 on success; emits err_json + exits non-zero on conflict.
# Operates on an existing session row identified by session_id.
session_claim() {
  local target="" sid="${CLAUDE_CODE_SESSION_ID:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --session-id) sid="$2"; shift 2 ;;
      --root)       target="golem-root"; shift ;;
      --id)         target="$2"; shift 2 ;;
      --*)          fail "unknown flag: $1"; exit 2 ;;
      *)            [[ -z "$target" ]] && target="$1" || { fail "extra arg: $1"; exit 2; }; shift ;;
    esac
  done
  [[ -n "$target" ]] || { fail "usage: golem session claim <project|--root> [--session-id <uuid>]"; exit 2; }
  [[ -n "$sid" ]]    || { fail "no session-id (CLAUDE_CODE_SESSION_ID unset, no --session-id flag)"; exit 2; }

  ensure_golem_root_registered

  # Resolve target → project_id
  local row; row="$(project_lookup "$target")"
  [[ -n "$row" ]] || err_json 30 not_registered "key=$target"
  local project_id; project_id="$(jq -r '.id' <<<"$row")"

  gc_stale_sessions

  # Look for any OTHER live session holding this project.
  local conflict; conflict="$(jq -c --arg id "$project_id" --arg sid "$sid" '
    .sessions[] | select(.claimed_project == $id and .session_id != $sid)
  ' "$SESSIONS_FILE" | head -1)"
  if [[ -n "$conflict" ]]; then
    local c_sid c_pid c_since
    c_sid="$(jq -r '.session_id' <<<"$conflict")"
    c_pid="$(jq -r '.pid' <<<"$conflict")"
    c_since="$(jq -r '.claimed_at' <<<"$conflict")"
    err_json 10 lock_conflict "project=$project_id" "held_by=$c_sid" "pid=$c_pid" "since=$c_since"
  fi

  local now; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # Idempotent: update existing session row (set claimed_project), or insert new
  # row if this session_id hasn't been registered yet (e.g. session_start was
  # bypassed). The latter records pid=0 — fine because we don't need PID to
  # release; PID liveness only matters for OTHER sessions checking against us.
  local exists; exists="$(jq --arg sid "$sid" '[.sessions[] | select(.session_id == $sid)] | length' "$SESSIONS_FILE")"
  if [[ "$exists" == "0" ]]; then
    session_register_row "$sid" 0 "$project_id"
  else
    registry_update "$SESSIONS_FILE" \
      ".sessions |= map(if .session_id == \"$sid\"
                         then .claimed_project = \"$project_id\" | .claimed_at = \"$now\"
                         else . end)"
  fi
  ok "claimed $project_id (session $sid)"
}

session_release() {
  local target="" sid="${CLAUDE_CODE_SESSION_ID:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --session-id) sid="$2"; shift 2 ;;
      --*)          fail "unknown flag: $1"; exit 2 ;;
      *)            [[ -z "$target" ]] && target="$1" || { fail "extra arg: $1"; exit 2; }; shift ;;
    esac
  done
  [[ -n "$sid" ]] || { fail "no session-id (CLAUDE_CODE_SESSION_ID unset, no --session-id flag)"; exit 2; }

  ensure_registry
  local row; row="$(jq -c --arg sid "$sid" '.sessions[] | select(.session_id == $sid)' "$SESSIONS_FILE" | head -1)"
  if [[ -z "$row" ]]; then
    # Nothing to release; silent success (idempotent for hook-driven calls).
    return 0
  fi

  # If caller specified <project>, verify it matches what's claimed (defensive).
  if [[ -n "$target" ]]; then
    local claimed; claimed="$(jq -r '.claimed_project // empty' <<<"$row")"
    local target_id; target_id="$(jq -r '.id // empty' <<<"$(project_lookup "$target")")"
    [[ -n "$target_id" ]] || err_json 30 not_registered "key=$target"
    if [[ "$claimed" != "$target_id" ]]; then
      err_json 12 wrong_session_release "session=$sid" "expected=$target_id" "actual=$claimed"
    fi
  fi

  registry_update "$SESSIONS_FILE" \
    ".sessions |= map(if .session_id == \"$sid\"
                       then .claimed_project = null | .claimed_at = null
                       else . end)"
  ok "released claim for $sid"
}

session_list() {
  local json=0
  case "${1:-}" in
    --json) json=1 ;;
  esac
  ensure_registry
  gc_stale_sessions
  if [[ $json -eq 1 ]]; then
    cat "$SESSIONS_FILE"; return 0
  fi
  head1 "Live CEO sessions"
  local count; count="$(jq '.sessions | length' "$SESSIONS_FILE")"
  if [[ "$count" == "0" ]]; then
    skip "(none)"
    return 0
  fi
  printf '  %-37s %-7s %-25s %s\n' "SESSION_ID" "PID" "CLAIMED_PROJECT" "BOOT_TIME"
  jq -r '.sessions[] | "  \(.session_id) \(.pid) \(.claimed_project // "—") \(.boot_time)"' "$SESSIONS_FILE" | column -t || true
}

session_stop() {
  local target="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)   target="--all"; shift ;;
      --force) force=1; shift ;;
      --*)     fail "unknown flag: $1"; exit 2 ;;
      *)       [[ -z "$target" ]] && target="$1" || { fail "extra arg: $1"; exit 2; }; shift ;;
    esac
  done
  [[ -n "$target" ]] || { fail "usage: golem session stop <session-id|--all> [--force]"; exit 2; }

  ensure_registry
  local sids=()
  if [[ "$target" == "--all" ]]; then
    mapfile -t sids < <(jq -r '.sessions[].session_id' "$SESSIONS_FILE")
  else
    sids=("$target")
  fi

  for sid in "${sids[@]}"; do
    [[ -z "$sid" ]] && continue
    local row; row="$(jq -c --arg sid "$sid" '.sessions[] | select(.session_id == $sid)' "$SESSIONS_FILE" | head -1)"
    if [[ -z "$row" ]]; then
      warn "no such session: $sid"
      continue
    fi
    local pid; pid="$(jq -r '.pid' <<<"$row")"
    if pid_alive "$pid"; then
      if [[ $force -eq 1 ]]; then
        kill -KILL "$pid" 2>/dev/null && ok "killed $sid (pid $pid)" || warn "kill -KILL failed: $pid"
      else
        kill -TERM "$pid" 2>/dev/null && ok "TERM sent to $sid (pid $pid)" || warn "kill failed: $pid"
      fi
    else
      skip "$sid: pid $pid already dead"
    fi
    # Always remove the row.
    registry_update "$SESSIONS_FILE" ".sessions |= map(select(.session_id != \"$sid\"))"
  done
}

# golem session start [--project <id|path>] [--root] [--new] [--detach]
session_start() {
  local persona="$TARGET_PERSONAS/golem-ceo.md"
  [[ -f "$persona" ]] || { fail "persona missing at $persona — run \`golem install\`"; exit 1; }
  command -v claude >/dev/null 2>&1 || { fail "\`claude\` not on PATH; install Claude Code first"; exit 1; }
  command -v jq     >/dev/null 2>&1 || { fail "\`jq\` not on PATH; required for the session/project registries"; exit 1; }

  local project_arg="" detach=0 want_new=0 passthru=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project_arg="$2"; shift 2 ;;
      --root)    project_arg="golem-root"; shift ;;
      --detach)  detach=1; shift ;;
      --new)     want_new=1; shift ;;
      --)        shift; passthru+=("$@"); break ;;
      *)         passthru+=("$1"); shift ;;
    esac
  done

  ensure_golem_root_registered
  gc_stale_sessions

  # If --project, resolve and pre-check conflict BEFORE spawning claude.
  local project_id=""
  if [[ -n "$project_arg" ]]; then
    local row; row="$(project_lookup "$project_arg")"
    [[ -n "$row" ]] || err_json 30 not_registered "key=$project_arg"
    project_id="$(jq -r '.id' <<<"$row")"
    local conflict; conflict="$(jq -c --arg id "$project_id" '
      .sessions[] | select(.claimed_project == $id)
    ' "$SESSIONS_FILE" | head -1)"
    if [[ -n "$conflict" ]]; then
      local c_sid c_pid c_since
      c_sid="$(jq -r '.session_id' <<<"$conflict")"
      c_pid="$(jq -r '.pid' <<<"$conflict")"
      c_since="$(jq -r '.claimed_at' <<<"$conflict")"
      err_json 10 lock_conflict "project=$project_id" "held_by=$c_sid" "pid=$c_pid" "since=$c_since"
    fi
  fi

  mkdir -p "$GOLEM_ROOT"
  cd "$GOLEM_ROOT"

  local session_id; session_id="$(gen_uuid)"
  build_channel_args

  # Multi-CEO: each CEO's channel-server child binds an ephemeral port (0 →
  # kernel-assigned). The channel server writes its bound port + this session's
  # id into ~/.config/golem/channels.json so the dashboard can fan out SSE
  # subscriptions. Allow override via the env so single-CEO smoke tests still
  # pin a known port.
  export GOLEM_CHANNEL_PORT="${GOLEM_CHANNEL_PORT:-0}"
  # The MCP child does NOT receive CLAUDE_CODE_SESSION_ID from Claude Code's
  # env (verified empirically: claude propagates user-set env like
  # GOLEM_CHANNEL_PORT to its MCP children, but does not stamp its own
  # session id). Export the id under our own name so the channel server can
  # register itself in ~/.config/golem/channels.json keyed by session.
  export GOLEM_CEO_SESSION_ID="$session_id"

  if [[ $detach -eq 1 ]]; then
    # Detached: spawn in background, record real PID, return.
    setsid claude \
      --session-id "$session_id" \
      --append-system-prompt-file "$persona" \
      --permission-mode acceptEdits \
      ${CHANNEL_ARGS[@]+"${CHANNEL_ARGS[@]}"} \
      ${passthru[@]+"${passthru[@]}"} \
      </dev/null >/dev/null 2>&1 &
    disown
    local pid=$!
    session_register_row "$session_id" "$pid" "${project_id:-null}"
    ok "spawned detached session $session_id (pid $pid)"
    [[ -n "$project_id" ]] && ok "claimed $project_id"
    return 0
  fi

  # Foreground: exec replaces this process, keeping its PID. Pre-register with $$.
  session_register_row "$session_id" "$$" "${project_id:-null}"
  ok "starting session $session_id"
  [[ -n "$project_id" ]] && ok "claimed $project_id"
  exec claude \
    --session-id "$session_id" \
    --append-system-prompt-file "$persona" \
    --permission-mode acceptEdits \
    ${CHANNEL_ARGS[@]+"${CHANNEL_ARGS[@]}"} \
    ${passthru[@]+"${passthru[@]}"}
}

cmd_session() {
  local sub="${1:-start}"
  case "$sub" in
    start|list|stop|claim|release)
      shift
      "session_$sub" "$@"
      ;;
    --*|"")
      # Backward-compat: `golem session` / `golem session --new ...`
      session_start "$@"
      ;;
    *)
      fail "unknown session subcommand: $sub"; exit 2 ;;
  esac
}

# ---- v3: status -----------------------------------------------------------

cmd_status() {
  local json=0
  case "${1:-}" in
    --json) json=1 ;;
  esac
  ensure_golem_root_registered
  gc_stale_sessions

  if [[ $json -eq 1 ]]; then
    local dash_url=""
    local dash_port="${PORT:-4173}"
    if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "http://127.0.0.1:$dash_port/healthz" >/dev/null 2>&1; then
      dash_url="http://127.0.0.1:$dash_port"
    fi
    local ch_port="${GOLEM_CHANNEL_PORT:-7421}"
    local ch_up=false
    if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "http://127.0.0.1:$ch_port/healthz" >/dev/null 2>&1; then
      ch_up=true
    fi
    jq -n --argjson projects "$(cat "$PROJECTS_FILE")" \
          --argjson sessions "$(cat "$SESSIONS_FILE")" \
          --arg dash "$dash_url" \
          --arg ch_port "$ch_port" \
          --argjson ch_up "$ch_up" '
      {
        projects: $projects.projects,
        sessions: $sessions.sessions,
        dashboard_url: $dash,
        channel: { port: ($ch_port | tonumber), reachable: $ch_up }
      }'
    return 0
  fi

  head1 "Projects ($GOLEM_CONFIG_DIR/projects.json)"
  jq -r '.projects[] | "  \(.id) [\(.kind)] \(.path)"' "$PROJECTS_FILE" || true

  head1 "Sessions ($GOLEM_CONFIG_DIR/sessions.json)"
  local n; n="$(jq '.sessions | length' "$SESSIONS_FILE")"
  if [[ "$n" == "0" ]]; then
    skip "(no live sessions)"
  else
    jq -r '.sessions[] | "  \(.session_id) pid=\(.pid) claim=\(.claimed_project // "—") since=\(.boot_time)"' "$SESSIONS_FILE"
  fi

  head1 "Dashboard"
  local dash_port="${PORT:-4173}"
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "http://127.0.0.1:$dash_port/healthz" >/dev/null 2>&1; then
    ok "running on http://127.0.0.1:$dash_port"
  else
    skip "not running (use \`golem dashboard\` to start)"
  fi

  head1 "Channel server"
  local ch_port="${GOLEM_CHANNEL_PORT:-7421}"
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "http://127.0.0.1:$ch_port/healthz" >/dev/null 2>&1; then
    ok "responding on 127.0.0.1:$ch_port"
  else
    skip "not running (auto-spawns with a CEO session)"
  fi
}

# ---- Subcommands (v2-derived: install, cleanup, reinstall, dashboard, doctor)

cmd_install() {
  head1 "Installing golem substrate from: $SUBSTRATE_DIR"

  head1 "1. Symlinking into ~/.claude/"
  shopt -s nullglob
  for src in "$SUBSTRATE_DIR/agents/"*.md;   do link_one "$src" "$TARGET_AGENTS/$(basename "$src")"   "agent";   done
  for src in "$SUBSTRATE_DIR/personas/"*.md; do link_one "$src" "$TARGET_PERSONAS/$(basename "$src")" "persona"; done
  for src in "$SUBSTRATE_DIR/commands/"*.md; do link_one "$src" "$TARGET_COMMANDS/$(basename "$src")" "command"; done
  for src in "$SUBSTRATE_DIR/skills/"*/; do
    [[ -f "$src/SKILL.md" ]] || continue
    name="$(basename "$src")"
    link_one "${src%/}" "$TARGET_SKILLS/$name" "skill"
  done
  shopt -u nullglob

  head1 "2. Putting \`golem\` on PATH"
  if [[ -L "$GOLEM_BIN_LINK" ]] && is_ours "$GOLEM_BIN_LINK"; then
    skip "golem already linked: $GOLEM_BIN_LINK"
  elif [[ -e "$GOLEM_BIN_LINK" ]]; then
    warn "$GOLEM_BIN_LINK exists, not overwriting"
  else
    mkdir -p "$TARGET_BIN"
    ln -s "$SUBSTRATE_DIR/bin/golem" "$GOLEM_BIN_LINK"
    ok "golem linked: $GOLEM_BIN_LINK"
  fi
  case ":$PATH:" in
    *":$TARGET_BIN:"*) ;;
    *) warn "$TARGET_BIN is not on PATH; add this to your shell rc:"
       warn "  export PATH=\"\$HOME/.local/bin:\$PATH\""
       ;;
  esac

  head1 "3. Registering the channel MCP server"
  install_mcp_json

  head1 "4. Initialising registry"
  ensure_golem_root_registered
  ok "registries at $GOLEM_CONFIG_DIR/"

  head1 "5. Installing JS deps"
  npm_install_in "$DASHBOARD_DIR" "dashboard"
  npm_install_in "$CHANNEL_DIR"   "channel-server"

  head1 "Done."
  echo
  echo "Next: open a fresh terminal (so PATH refreshes) and run:"
  echo "  golem doctor                  # confirm everything is wired"
  echo "  golem session start           # start the interactive CEO session"
  echo "  golem dashboard               # in another terminal, start the dashboard"
}

cmd_cleanup() {
  head1 "Cleaning up golem substrate"

  head1 "1. Removing ~/.claude/ symlinks"
  unlink_dir_contents "$TARGET_AGENTS"   "agent"
  unlink_dir_contents "$TARGET_PERSONAS" "persona"
  unlink_dir_contents "$TARGET_COMMANDS" "command"
  unlink_dir_contents "$TARGET_SKILLS"   "skill"

  head1 "2. Removing golem from PATH"
  if [[ -L "$GOLEM_BIN_LINK" ]] && is_ours "$GOLEM_BIN_LINK"; then
    rm "$GOLEM_BIN_LINK"
    ok "removed $GOLEM_BIN_LINK"
  else
    skip "no golem symlink at $GOLEM_BIN_LINK"
  fi

  head1 "3. Removing channel MCP registration"
  cleanup_mcp_json

  if [[ "${1:-}" == "--purge" ]]; then
    head1 "4. Removing node_modules (--purge)"
    for d in "$DASHBOARD_DIR/node_modules" "$CHANNEL_DIR/node_modules"; do
      if [[ -d "$d" ]]; then
        rm -rf "$d"
        ok "removed $d"
      fi
    done
  else
    head1 "4. node_modules left in place"
    skip "use \`golem cleanup --purge\` to remove dashboard + channel-server node_modules"
  fi

  head1 "Done."
}

cmd_reinstall() {
  cmd_cleanup
  echo
  cmd_install
}

cmd_dashboard() {
  [[ -n "$DASHBOARD_DIR" ]] || { fail "dashboard dir not found relative to substrate"; exit 1; }
  [[ -d "$DASHBOARD_DIR/node_modules" ]] || { fail "dashboard deps missing — run \`golem install\` first"; exit 1; }
  command -v npm >/dev/null 2>&1 || { fail "\`npm\` not on PATH; install Node 20+"; exit 1; }
  cd "$DASHBOARD_DIR"
  exec npm start "$@"
}

cmd_doctor() {
  head1 "golem doctor"
  local failures=0

  check() {
    local label="$1" cond="$2"
    if eval "$cond" >/dev/null 2>&1; then ok "$label"; else fail "$label"; failures=$((failures+1)); fi
  }

  head1 "Symlinks in ~/.claude/"
  check "personas/golem-ceo.md"            "[[ -L '$TARGET_PERSONAS/golem-ceo.md' ]]"
  check "agents/ has golem-* links"        "compgen -G '$TARGET_AGENTS/golem-*.md'"
  check "skills/ has golem-* links"        "compgen -G '$TARGET_SKILLS/golem-*'"
  check "commands/golem.md"                "[[ -L '$TARGET_COMMANDS/golem.md' ]]"

  head1 "PATH wiring"
  check "~/.local/bin/golem symlink"       "[[ -L '$GOLEM_BIN_LINK' ]]"
  check "~/.local/bin on PATH"             "[[ \":\$PATH:\" == *\":$TARGET_BIN:\"* ]]"
  check "\`claude\` on PATH"                "command -v claude"
  check "\`jq\` on PATH (registry I/O)"     "command -v jq"

  head1 "Channel server registration"
  check "$MCP_JSON_PATH exists"            "[[ -f '$MCP_JSON_PATH' ]]"
  if [[ -f "$MCP_JSON_PATH" ]]; then
    if diff -q <(expected_mcp_json) "$MCP_JSON_PATH" >/dev/null 2>&1; then
      ok ".mcp.json matches expected"
    else
      warn ".mcp.json exists but differs (probably hand-merged with other servers)"
    fi
  fi

  head1 "v3 registry"
  ensure_golem_root_registered
  check "projects.json exists"             "[[ -f '$PROJECTS_FILE' ]]"
  check "sessions.json exists"             "[[ -f '$SESSIONS_FILE' ]]"
  check "golem-root registered"            "jq -e '.projects | map(.id) | index(\"golem-root\")' '$PROJECTS_FILE'"

  head1 "JS dependencies"
  check "dashboard/node_modules"           "[[ -d '$DASHBOARD_DIR/node_modules' ]]"
  check "channels/golem/node_modules"      "[[ -d '$CHANNEL_DIR/node_modules' ]]"

  head1 "Channel server reachability (optional)"
  local port="${GOLEM_CHANNEL_PORT:-7421}"
  if command -v curl >/dev/null 2>&1 && curl -fsS --max-time 1 "http://127.0.0.1:$port/healthz" >/dev/null 2>&1; then
    ok "channel server responding on 127.0.0.1:$port"
  else
    skip "channel server not running on 127.0.0.1:$port (only matters while a CEO session is live)"
  fi

  echo
  if [[ $failures -eq 0 ]]; then
    ok "all critical checks passed"
  else
    fail "$failures critical check(s) failed — run \`golem install\` to fix"
    exit 1
  fi
}

cmd_help() {
  cat <<EOF
golem — unified CLI for the substrate.

Usage:
  golem <command> [args]

Setup:
  install              One-time global setup (symlinks, .mcp.json, npm deps). Idempotent.
  reinstall            Cleanup, then install.
  cleanup [--purge]    Reverse install. --purge also removes node_modules.

Run:
  session [start] [--project <id|path>] [--root] [--new] [--detach] [-- claude-args…]
                       Start a CEO Claude Code session. Pre-claims --project if passed.
                       Bare \`golem session\` is equivalent to \`golem session start\`.
  session list [--json]
                       List live CEO sessions.
  session stop <session-id|--all> [--force]
                       Terminate one or all sessions.
  session claim <project|--root> [--session-id <uuid>]
                       Acquire a project lock for the current session.
                       Reads CLAUDE_CODE_SESSION_ID if --session-id is omitted.
  session release [--session-id <uuid>] [<project>]
                       Release the current session's claim.

  project register <path> [--name <pretty>] [--id <slug>] [--kind project|external]
                       Add a project to the registry.
  project unregister <id|path> [--force]
                       Remove a project from the registry.
  project list [--kind <kind>] [--json]
                       List registered projects.
  project info <id>
                       Print one project's metadata + current claim if any.

  dashboard            Start the admin dashboard on http://localhost:4173.

Inspect:
  doctor               Sanity-check the environment.
  status [--json]      Combined snapshot: sessions + projects + dashboard / channel reachability.
  help                 Show this message.

Environment:
  GOLEM_ROOT             Workspace anchor (default: ~/Documents/software/experiments/golem).
  GOLEM_CEO_CHANNELS     Space-separated channel specs for \`session start\` (default: server:golem).
  GOLEM_CHANNEL_PORT     Channel server port (default: 7421).
  CLAUDE_CODE_SESSION_ID Set automatically inside a CEO session — used by claim/release.

Registry: $GOLEM_CONFIG_DIR/
Substrate: $SUBSTRATE_DIR
EOF
}

# ---- Dispatch -------------------------------------------------------------

cmd="${1:-help}"
shift || true
case "$cmd" in
  install)     cmd_install "$@" ;;
  reinstall)   cmd_reinstall "$@" ;;
  cleanup)     cmd_cleanup "$@" ;;
  session)     cmd_session "$@" ;;
  project)     cmd_project "$@" ;;
  dashboard)   cmd_dashboard "$@" ;;
  doctor)      cmd_doctor "$@" ;;
  status)      cmd_status "$@" ;;
  help|-h|--help) cmd_help ;;
  *) fail "unknown command: $cmd"; echo; cmd_help; exit 2 ;;
esac
