{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "tools/**",
      "scripts/**",
      "!**/dist/**",
      "!**/node_modules/**",
      "!dashboard/dist/**",
      "!apps/control-plane/generated/**",
      "!packages/contracts/generated/**",
		"!packages/api-client/src/generated/**",
      "!plugin/**",
      "!test/fixtures/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true
  }
}
