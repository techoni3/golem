{
  "$id": "urn:golem:contracts:capability-record:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_version": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "capability_id": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    },
    "delivery_mode": {
      "enum": [
        "pull",
        "native_channel",
        "prompt_bridge",
        "managed_app_server",
        "next_turn"
      ],
      "type": "string"
    },
    "evidence_version": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "harness": {
      "enum": [
        "claude",
        "codex",
        "opencode",
        "pi"
      ],
      "type": "string"
    },
    "integration_layers": {
      "items": {
        "enum": [
          "extension",
          "hooks",
          "mcp",
          "channel",
          "app_server",
          "prompt_bridge"
        ],
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "qualification": {
      "enum": [
        "supported",
        "experimental",
        "unsupported",
        "unknown"
      ],
      "type": "string"
    },
    "readiness": {
      "enum": [
        "ready",
        "held_busy",
        "held_waiting",
        "pull_only",
        "next_turn",
        "unsupported",
        "unhealthy",
        "uninitialized"
      ],
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "golem.capability-record/v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "capability_id",
    "harness",
    "adapter_version",
    "integration_layers",
    "qualification",
    "delivery_mode",
    "readiness"
  ],
  "type": "object",
  "x-golem-contract-semver": "1.0.0",
  "x-golem-wire-version": "golem.capability-record/v1"
}
