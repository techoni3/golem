{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:golem:contracts:diagnostics-explanation:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "event_ids": {
      "items": {
        "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 64,
      "type": "array"
    },
    "facts": {
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "message": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "remediation": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "schema_version": {
      "const": "golem.diagnostics-explanation/v1",
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "code",
    "severity",
    "message",
    "event_ids",
    "facts",
    "remediation"
  ],
  "type": "object",
  "x-golem-contract-semver": "1.0.0",
  "x-golem-wire-version": "golem.diagnostics-explanation/v1"
}
