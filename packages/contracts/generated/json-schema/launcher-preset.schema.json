{
  "$id": "urn:golem:contracts:launcher-preset:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "enum": [
        "openai",
        "anthropic",
        "ollama_local",
        "ollama_cloud",
        "native"
      ],
      "type": "string"
    },
    "binary_override": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "delivery_mode": {
      "enum": [
        "pull",
        "native_channel",
        "prompt_bridge",
        "managed_app_server",
        "next_turn"
      ],
      "type": "string"
    },
    "env_key_refs": {
      "items": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "type": "string"
      },
      "maxItems": 16,
      "type": "array"
    },
    "harness": {
      "enum": [
        "claude",
        "codex",
        "opencode",
        "pi"
      ],
      "type": "string"
    },
    "model_selector": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "type": "string"
    },
    "native_args": {
      "items": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "type": "array"
    },
    "schema_version": {
      "const": "golem.launcher-preset/v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "name",
    "harness",
    "backend",
    "model_selector",
    "delivery_mode",
    "native_args",
    "env_key_refs"
  ],
  "type": "object",
  "x-golem-contract-semver": "1.0.0",
  "x-golem-wire-version": "golem.launcher-preset/v1"
}
