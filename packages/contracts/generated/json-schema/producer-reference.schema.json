{
  "$id": "urn:golem:contracts:producer-reference:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "harness": {
      "enum": [
        "claude",
        "codex",
        "opencode",
        "pi"
      ],
      "type": "string"
    },
    "producer": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "producer_instance_id": {
      "pattern": "^prod_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "schema_version": {
      "const": "golem.producer-reference/v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "producer",
    "producer_instance_id",
    "harness"
  ],
  "type": "object",
  "x-golem-contract-semver": "1.0.0",
  "x-golem-wire-version": "golem.producer-reference/v1"
}
