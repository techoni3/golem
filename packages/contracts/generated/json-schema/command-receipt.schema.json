{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "urn:golem:contracts:command-receipt:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "command_id": {
      "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "command_kind": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "committed_at": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "fingerprint": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "outcome": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^op_[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/__schema0"
        },
        "schema_version": {
          "const": "golem.api-command-outcome/v1",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "completed",
            "rejected",
            "conflict",
            "pending",
            "idempotency_mismatch"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "command_id",
        "status"
      ],
      "type": "object"
    },
    "project_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "resource_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "resource_type": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "golem.command-receipt/v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "command_id",
    "idempotency_key",
    "command_kind",
    "actor_id",
    "project_id",
    "resource_type",
    "resource_id",
    "correlation_id",
    "fingerprint",
    "outcome",
    "committed_at"
  ],
  "type": "object",
  "x-golem-contract-semver": "1.0.0",
  "x-golem-wire-version": "golem.command-receipt/v1"
}
