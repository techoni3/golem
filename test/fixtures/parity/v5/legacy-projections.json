{
  "schema_version": "golem-parity-fixture/v5",
  "purpose": "Sanitized projections for future legacy-versus-replacement comparisons; never copied from a live Golem home.",
  "projections": {
    "project": {
      "id": "project-alpha",
      "display_name": "Alpha",
      "location": "$PATH_1"
    },
    "sessions": [
      {
        "id": "session-managed",
        "harness": "codex",
        "delivery_mode": "managed_app_server",
        "readiness": "ready"
      },
      {
        "id": "session-direct",
        "harness": "codex",
        "delivery_mode": "pull",
        "readiness": "pull_only"
      },
      {
        "id": "session-pi",
        "harness": "pi",
        "delivery_mode": "next_turn",
        "readiness": "next_turn"
      }
    ],
    "dispatch": {
      "envelope": "envelope-alpha",
      "state": "acknowledged",
      "queue_order": ["first", "second"]
    }
  }
}
