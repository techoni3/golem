{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golem.local/schemas/acceptance-result-v1.json",
  "title": "Golem J1-J8 acceptance result",
  "type": "object",
  "required": ["schema_version", "overall", "artifact", "entry_gate", "matrices", "residual_risks"],
  "properties": {
    "schema_version": { "const": "golem.acceptance/v1" },
    "overall": { "enum": ["PASS", "FAIL", "UNMET"] },
    "artifact": {
      "type": "object",
      "required": ["kind", "filename", "sha256", "files", "package", "version"],
      "properties": {
        "kind": { "const": "packed" },
        "filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "files": { "type": "integer", "minimum": 1 },
        "package": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "entry_gate": { "type": "object" },
    "matrices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "scenarios"],
        "properties": {
          "id": { "pattern": "^J[1-8]$" },
          "status": { "enum": ["PASS", "FAIL", "UNMET"] },
          "scenarios": { "type": "array", "minItems": 1 }
        }
      }
    },
    "residual_risks": { "type": "array" }
  }
}
