{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Golem real-process journey summary",
  "type": "object",
  "required": ["schema_version", "overall", "results"],
  "properties": {
    "schema_version": { "const": "golem-journey-summary/v1" },
    "overall": { "enum": ["PASS", "FAIL", "UNMET"] },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "journey", "tier", "regression", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "journey": { "enum": ["J1", "J2", "J3", "J4", "J5", "J6", "J7", "J8"] },
          "tier": { "enum": ["pr", "integration", "release"] },
          "regression": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "UNMET"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
