{
  "name": "golem",
  "version": "5.0.3",
  "description": "Golem — substrate compiler, dashboard/tracker, and CLI for the agentic harness.",
  "type": "module",
  "bin": {
    "golem": "./cli/golem.js"
  },
  "exports": {
    ".": "./cli/golem.js",
    "./opencode-shim": "./shims/opencode/index.js"
  },
  "files": [
    "cli/",
    "dashboard/server/",
    "dashboard/web/",
    "lib/",
    "plugin/",
    "shims/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check cli/golem.js",
    "dashboard": "node dashboard/server/index.js",
    "dashboard:dev": "node --watch dashboard/server/index.js",
    "check:dashboard": "dashboard/scripts/check.sh"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "fastify": "^4.28.1",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^14.1.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "playwright-core": "^1.61.0"
  }
}
