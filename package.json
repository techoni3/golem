{
  "name": "@laveesingh/golem",
  "version": "5.1.1",
  "description": "Golem — substrate compiler, dashboard/tracker, and CLI for the agentic harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laveesingh/golem.git"
  },
  "bugs": {
    "url": "https://github.com/laveesingh/golem/issues"
  },
  "homepage": "https://github.com/laveesingh/golem#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*",
    "tools/*"
  ],
  "bin": {
    "golem": "./cli/golem.js"
  },
  "exports": {
    ".": "./cli/golem.js",
    "./opencode-shim": "./shims/opencode/index.js"
  },
  "files": [
    "dist/apps/cli/",
    "apps/cli/",
    "cli/",
    "dashboard/server/",
    "dashboard/dist/",
    "dashboard/web/",
    "lib/",
    "mcp/channel/",
    "packages/mcp-adapter/dist/golem-mcp.mjs",
    "plugin/",
    "shims/",
    "substrate/",
    "CONTRIBUTING.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=24.18.0 <25"
  },
	"scripts": {
    "api:check": "npm run build -w @golem/control-plane && npm run openapi -w @golem/control-plane && npm run check -w @golem/openapi-codegen && node tools/openapi-codegen/generate.mjs --check",
    "api:generate": "npm run build -w @golem/control-plane && npm run openapi -w @golem/control-plane && npm run generate -w @golem/openapi-codegen",
    "build": "npm run typecheck && npm run build -w @golem/compiler -w @golem/mcp-adapter -w @golem/dashboard",
    "check": "npm run typecheck && npm run check:boundaries && npm run check:strictness && npm run lint && npm run check:legacy",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:legacy": "node --check cli/golem.js && node cli/golem.js sync --check --all",
    "check:strictness": "node scripts/check-strictness.mjs",
    "clean": "node scripts/clean-workspace.mjs",
    "contracts:check": "npm run build -w @golem/contracts && npm run check -w @golem/contracts",
    "contracts:generate": "npm run build -w @golem/contracts && npm run generate -w @golem/contracts",
    "lint": "biome check apps packages tools scripts --no-errors-on-unmatched",
    "test": "node test/session-facts.test.mjs && node test/codex-journey.test.mjs && node test/pi-journey.test.mjs && node test/pi-tracker-integration.test.mjs && node test/sync-enforcement.test.mjs && node shims/opencode/resume-dispatchable.test.mjs && node shims/opencode/passive-delta.test.mjs && node mcp/channel/tracker-client.test.mjs",
    "verify:stack": "node test/stack-certification/run.mjs",
    "test:stack-certification": "node --test test/stack-certification/version-gate.test.mjs",
    "test:ui-primitives": "npm run build -w @golem/ui && npm run build -w @golem/dashboard && node test/ui-primitives.mjs",
    "test:legacy-baseline": "node test/parity/legacy-baseline.mjs",
    "test:contracts": "npm run contracts:check && node --test test/contracts/contracts-v1.test.mjs",
    "test:domain": "npm run build -w @golem/domain && node --test test/domain/kernel-replay.test.mjs",
    "test:persistence": "npm run build -w @golem/persistence -w @golem/control-plane && node --test --test-concurrency=1 test/persistence/sqlite-owner-migration-recovery.test.mjs",
    "test:projects": "npm run build -w @golem/persistence -w @golem/runtime -w @golem/control-plane -w @golem/testkit && node --test --test-concurrency=1 test/projects/project-identity-git-worktree-relocation.test.mjs test/projects/project-register-concurrency.test.mjs",
		"test:sessions": "npm run build -w @golem/persistence -w @golem/runtime -w @golem/control-plane -w @golem/testkit && node --test --test-concurrency=1 test/sessions/session-service.test.mjs",
		"test:endpoints": "npm run build -w @golem/persistence -w @golem/runtime -w @golem/control-plane -w @golem/testkit && node --test --test-concurrency=1 test/endpoints/endpoint-service.test.mjs",
    "test:runtime-engine": "npm run build -w @golem/testkit -w @golem/runtime -w @golem/persistence -w @golem/control-plane && node --test --test-concurrency=1 test/runtime/materializer-crash-matrix.test.mjs test/runtime/dashboard-down-inbox-replay.test.mjs",
		"test:runtime-projections": "npm run build -w @golem/persistence -w @golem/runtime -w @golem/control-plane -w @golem/testkit && node --test --test-concurrency=1 test/runtime/runtime-projections.test.mjs",
		"test:delivery-bus": "npm run build -w @golem/persistence -w @golem/tracker -w @golem/testkit -w @golem/control-plane && node --test --test-concurrency=1 test/tracker/delivery-bus.test.mjs",
		"test:tracker-core": "npm run build -w @golem/persistence -w @golem/tracker -w @golem/testkit -w @golem/control-plane && node --test --test-concurrency=1 test/tracker/tracker-core.test.mjs",
		"test:management": "npm run build -w @golem/persistence -w @golem/tracker -w @golem/control-plane -w @golem/testkit && node --test --test-concurrency=1 test/management/management-services.test.mjs",
    "test:launcher-resolution": "npm run build -w @golem/launcher && node --test test/launcher-resolution.test.mjs",
    "test:launcher-process": "npm run build -w @golem/launcher -w @golem/testkit && node --test --test-concurrency=1 test/launcher-process.test.mjs",
    "test:cli": "npm run build -w apps/cli && node --test --test-concurrency=1 test/cli/registry.test.mjs",
    "migration:plan": "npm run build -w @golem/compat && node packages/compat/bin/migration-plan.mjs plan",
    "migration:apply": "npm run build -w @golem/compat && node packages/compat/bin/migration-plan.mjs apply",
    "migration:status": "npm run build -w @golem/compat && node packages/compat/bin/migration-plan.mjs status",
    "migration:rollback": "npm run build -w @golem/compat && node packages/compat/bin/migration-plan.mjs rollback",
    "test:migration-plan": "npm run build -w @golem/compat -w @golem/testkit && node --test --test-concurrency=1 test/migration-plan.test.mjs",
    "test:migration-apply": "npm run build -w @golem/compat -w @golem/testkit && node --test --test-concurrency=1 test/migration-apply.test.mjs",
    "migration:fixtures:check": "npm run test:migration-plan && npm run test:migration-apply",
    "test:testkit": "npm run build -w @golem/testkit && node --test --test-concurrency=1 test/journeys/testkit.test.mjs",
    "test:journey": "npm run build -w @golem/compiler -w @golem/mcp-adapter -w @golem/domain -w @golem/launcher -w @golem/compat -w @golem/testkit -w @golem/persistence -w @golem/runtime -w @golem/tracker -w @golem/control-plane -w @golem/api-client -w @golem/adapter-codex -w @golem/adapter-opencode -w @golem/adapter-pi && node test/journeys/run.mjs",
    "test:adapter:codex-direct": "npm run build -w @golem/adapter-codex && node --test --test-concurrency=1 test/codex-direct-adapter.test.mjs",
    "test:adapter:opencode": "npm run build -w @golem/adapter-opencode -w @golem/runtime -w @golem/persistence -w @golem/control-plane -w apps/cli && node --test --test-concurrency=1 test/adapter/opencode.test.mjs",
    "qualify:opencode": "npm run build -w @golem/adapter-opencode && node tools/qualify-opencode.mjs",
    "db:fixtures:check": "npm run build -w @golem/persistence -w @golem/control-plane && node --test --test-concurrency=1 test/persistence/sqlite-owner-migration-recovery.test.mjs",
    "test:browser": "npm run build -w @golem/testkit -w @golem/control-plane -w @golem/api-client && node test/browser/run.mjs",
    "postinstall": "npm --prefix mcp/channel ci --omit=dev --workspaces=false",
    "prepack": "npm run build -w @golem/compiler -w @golem/mcp-adapter -w apps/cli",
    "test:release": "node test/release-smoke.mjs",
    "verify:render": "npm run test:journey -- --scenario render-mcp-closure",
    "dashboard": "node dashboard/server/index.js",
    "dashboard:build": "vite build --config dashboard/vite.config.js",
    "dashboard:dev": "vite --config dashboard/vite.config.js",
    "dashboard:serve": "npm run dashboard:build && node dashboard/server/index.js",
    "test:dashboard:browser": "node dashboard/scripts/gol-461-browser.mjs && node dashboard/scripts/gol-495-browser.mjs",
    "check:dashboard": "dashboard/scripts/check.sh",
    "typecheck": "tsc -b --stopBuildOnErrors"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@lobehub/icons-static-svg": "1.91.0",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "dompurify": "^3.2.6",
    "fastify": "^4.28.1",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^14.1.4",
    "mermaid": "^11.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@biomejs/biome": "2.5.4",
    "@types/node": "^24.10.4",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.61.0",
    "typescript": "7.0.2",
    "vite": "^6.3.5"
  }
}
