{
  "name": "@laveesingh/golem",
  "version": "5.0.16",
  "description": "Golem — substrate compiler, dashboard/tracker, and CLI for the agentic harness.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laveesingh/golem.git"
  },
  "bugs": {
    "url": "https://github.com/laveesingh/golem/issues"
  },
  "homepage": "https://github.com/laveesingh/golem#readme",
  "type": "module",
  "bin": {
    "golem": "./cli/golem.js"
  },
  "exports": {
    ".": "./cli/golem.js",
    "./opencode-shim": "./shims/opencode/index.js"
  },
  "files": [
    "cli/",
    "dashboard/server/",
    "dashboard/web/",
    "lib/",
    "mcp/channel/",
    "plugin/",
    "shims/",
    "substrate/",
    "CONTRIBUTING.md",
    "LICENSE",
    "PRIVACY.md",
    "README.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check cli/golem.js && node cli/golem.js sync --check --all",
    "test": "node test/sync-enforcement.test.mjs && node shims/opencode/resume-dispatchable.test.mjs && node shims/opencode/passive-delta.test.mjs && node mcp/channel/tracker-client.test.mjs",
    "postinstall": "npm ci --omit=dev --prefix mcp/channel",
    "test:release": "node test/release-smoke.mjs",
    "dashboard": "node dashboard/server/index.js",
    "dashboard:dev": "node --watch dashboard/server/index.js",
    "check:dashboard": "dashboard/scripts/check.sh"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "better-sqlite3": "^11.10.0",
    "chokidar": "^3.6.0",
    "fastify": "^4.28.1",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1",
    "marked": "^14.1.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "playwright-core": "^1.61.0"
  }
}
